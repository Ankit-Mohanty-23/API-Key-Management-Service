generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////

enum UserRole {
  ADMIN
  PROVIDER
  CONSUMER
}

enum HttpMethod {
  GET
  POST
  PUT
  PATCH
  DELETE
}

//////////////////////////////////////////////////////
// USERS
//////////////////////////////////////////////////////

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  role         UserRole   @default(CONSUMER)

  apiKeys      ApiKey[]
  providedApis Api[]      @relation("ProviderApis")
  usageLogs    ApiUsageLog[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

//////////////////////////////////////////////////////
// API KEYS
//////////////////////////////////////////////////////

model ApiKey {
  id         String   @id @default(uuid())
  key        String   @unique
  name       String?  // optional label like "Production key"
  isActive   Boolean  @default(true)

  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  usageLogs  ApiUsageLog[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

//////////////////////////////////////////////////////
// APIS (registered by providers)
//////////////////////////////////////////////////////

model Api {
  id          String        @id @default(uuid())
  name        String
  description String?
  baseUrl     String

  providerId  String
  provider    User          @relation("ProviderApis", fields: [providerId], references: [id], onDelete: Cascade)

  endpoints   ApiEndpoint[]
  usageLogs   ApiUsageLog[]

  isActive    Boolean       @default(true)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

//////////////////////////////////////////////////////
// API ENDPOINTS
//////////////////////////////////////////////////////

model ApiEndpoint {
  id          String      @id @default(uuid())
  path        String      // /weather/current
  method      HttpMethod

  apiId       String
  api         Api         @relation(fields: [apiId], references: [id], onDelete: Cascade)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([apiId, path, method])
}

//////////////////////////////////////////////////////
// API USAGE LOGS (analytics + tracking)
//////////////////////////////////////////////////////

model ApiUsageLog {
  id           String   @id @default(uuid())

  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  apiKeyId     String
  apiKey       ApiKey   @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  apiId        String
  api          Api      @relation(fields: [apiId], references: [id], onDelete: Cascade)

  endpoint     String
  method       HttpMethod

  statusCode   Int
  responseTime Int      // ms

  ipAddress    String?

  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([apiId])
  @@index([apiKeyId])
  @@index([createdAt])
}